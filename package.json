{
  "name": "dsh-codex-usage",
  "version": "0.1.1",
  "description": "Remaining five-hour and weekly Codex usage for dsh-codex-provider.",
  "type": "module",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": { "test": "node --test tests/*.test.js", "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/usage.js" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-slots", "@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-session", "@deepseek-ai/dsh-client-ui-model-selection"],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "dsh-codex-provider": ">=0.1.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "dsh-codex-provider": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true },
    "react": { "optional": true }
  }
}
